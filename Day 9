// i/p 
//  5
//  0 1 0 1 0 
//  o/p
//  0 0 0 1 1 
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		int i=0;
		for(i=0;i<5;i++){
		    arr[i] = sc.nextInt();
		}
		System.out.print("before change");
		System.out.println();
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
		System.out.println();
		int zc=0;
		for(i=0;i<n;i++){
		    if(arr[i] == 0){
		        zc++;
		    }
		}
		for(i=0;i<zc;i++){
		    arr[i] = 0;
		}
		for(i=zc;i<n;i++){
		    arr[i] = 1;
		}
		System.out.println();
		System.out.print("after change");
		System.out.println();
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
	}
}


