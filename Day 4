// program to print Base 1 Pattern 
// i/p        o/p
// 5           *****
//             *****
//             *****
//             *****
//             *****
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int row,col;
		for(row=0;row<n;row++){
		    for(col=0;col<n;col++){
		        System.out.print("*");
		    }
		    System.out.println();
		}
	}
}
