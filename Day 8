//write a java program to find the sum of array elements
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		int i = 0;
		int s=0;
		for(i=0;i<n;i++){
		    arr[i]  = sc.nextInt();
		    s+=arr[i];
		}
		System.out.print(s);
}
}

Output:
4
1
2
3
4
10
