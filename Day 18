import java.util.*;
public class Main{
    public static void main(String[] args){
        ArrayList<Integer> obj = new ArrayList<Integer>();
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for (int i=0;i<n;i++){
            obj.add(sc.nextInt());
        }
        int ind = sc.nextInt();
        int val = sc.nextInt();
        obj.add(ind,val);
        int in = sc.nextInt();
        int vl = sc.nextInt();
        obj.set(in,vl);
        System.out.print(obj);
    }
}

