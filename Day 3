//  program to find the factorial of a given number
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("enter the number");
		int n = sc.nextInt();
		int fact=1;
		if(n==0||n==1) {
			fact = 1;
		}

		else {
			for (int i=1; i<=n; i++) {
				fact*=i;
			}
		}
		System.out.print(fact);
	}
}

