//  program to get the starting and the ending range and find the sum of the 
// elemnets in the given range
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    System.out.print("enter the intial and final number");
	    int s = sc.nextInt();
	    int f = sc.nextInt();
	    int sum=0;
	    for (int i=s;i<=f;i++){
	        sum+=i;
	    }
	    System.out.print("the sum of the numbers between the range "+ s + " and "+ f + " is : " + sum);
	}
}

